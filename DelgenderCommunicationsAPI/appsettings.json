{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=HOST_HERE;Port=PORT_HERE;Database=DATABASE_NAME;Username=USERNAME;Password=PASSWORD"
  },
  "JwtSettings": {
    "SecretKey": "<SECRET_KEY>",
    "Issuer": "Delgender Communications",
    "Audience": "Delgender Communications Users",
    "ExpiresInHours": "8"
  }
}
