{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=HOST_HERE;Port=PORT_HERE;Database=DATABASE_NAME;Username=USERNAME;Password=PASSWORD"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "EMAIL@HERE.COM",
    "SenderPassword": "APP PASSWORD",
    "SenderName": "NAME HERE"
  },
  "JwtSettings": {
    "SecretKey": "<SECRET_KEY>",
    "Issuer": "BookingAPI",
    "Audience": "Businesses",
    "ExpiresInHours": "8"
  }
}
